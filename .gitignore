__pycache__/
*.pyc
*.pyo
config.local.yaml
nbs_cache.json
*.tmp
*.bak
# data 目录：忽略所有产物数据，仅保留活跃入口脚本受版本控制
data/*
!data/refresh.py
!data/daily_run.ps1
!data/serve.py
!data/run_all.py
!data/sync_data.py
!data/rebuild_hyps.py
!data/watchdog.ps1
!data/hypotheses/
# 分词器词表（2026-09-30）：不是产物而是**配置资产**——缺失会让 _tokens 静默降级
# 为字符 2-gram，匹配行为无声改变。必须入库（370KB），由 tools/train_sp_tokenizer.py 重训。
!data/.sp_unigram.model
!data/.sp_unigram.vocab
# hypotheses 目录内仍需排除：目录级 ! 规则会覆盖上面的 *.bak，导致时间戳备份入库
data/hypotheses/*.bak_*
data/hypotheses/*.bak
# ACH 诊断流水日志（体积大、可由矩阵重建，不入库）
data/hypotheses/diagnosis_log.jsonl

# 截图等大文件不入库
*.png

_patch_*
_test_*
.mimosa/
.zcode/
.workbuddy/
_tmp_raw_resp.txt
intel_raw_*
rss_*
list_*
.playwright-mcp/
