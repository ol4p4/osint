# -*- coding: utf-8 -*-
r"""dialogue_engine.py - P2a 对话引擎
流程：用户说想法 → 5 轮追问(WHAT/WHY/HOW/WHEN/WHO，AI 结合上下文深化) → 结构化观点卡
     → (可选)喂给假设树检验

用法：
  交互模式   python dialogue_engine.py --interactive "你的想法"
  草稿文件   python dialogue_engine.py --idea-file <idea.md>
  批量模式   python dialogue_engine.py --batch <idea目录>   (Obsidian 草稿逐个出卡)
观点卡落盘：{output_dir}\dialogues\view_cards\ ；对话记录：{output_dir}\dialogues\
"""
import argparse
import json
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

QUESTION_ROUNDS = [
    {"round": 1, "name": "WHAT", "prompt": "你说的[观点]具体指什么？请从以下维度中选择或补充：经济结构、社会政策、制度设计、文化传统、人口趋势、国际关系。"},
    {"round": 2, "name": "WHY", "prompt": "你基于什么得出这个判断？是读过什么书、看过什么数据、还是个人观察和经历？请具体说明。"},
    {"round": 3, "name": "HOW", "prompt": "这个观点如何验证？什么数据出现能支持它？什么数据出现能反驳它？请给出具体的可观察指标。"},
    {"round": 4, "name": "WHEN", "prompt": "你认为这个判断的时间跨度是多长？什么时候能验证对错？给出一个到期日。"},
    {"round": 5, "name": "WHO", "prompt": "这个判断对谁影响最大？对你个人意味着什么？你会因此做出什么改变？"},
]

CARD_PROMPT_TEMPLATE = (
    "\n\n把以上对话浓缩为结构化观点卡，严格只输出 JSON（不要 markdown）："
    '{{"title":"15字内标题","core_claim":"核心观点一句话",'
    '"evidence_basis":"依据（书/数据/经历）","key_dimensions":["维度1","维度2"],'
    '"verifiable_indicators":["可观察指标1","指标2"],'
    '"refute_criteria":"什么数据出现说明错了",'
    '"time_horizon_months":12,"personal_impact":"对用户个人的影响"}}'
)


class DialogueEngine:
    def __init__(self, config, idea_dir=None):
        self.config = config or {}
        paths = self.config.get("paths", {})
        self.output_dir = Path(paths.get("output_dir", r"D:\Codex输出\osint_卫星图"))
        self.dialogue_dir = self.output_dir / "dialogues"
        self.cards_dir = self.dialogue_dir / "view_cards"
        self.dialogue_dir.mkdir(parents=True, exist_ok=True)
        self.cards_dir.mkdir(parents=True, exist_ok=True)
        self.idea_dir = Path(idea_dir) if idea_dir else None
        self._analyzer = None

    # ---------- AI ----------
    def _ai(self):
        """延迟初始化 AI 调用器，复用 analyze.MacroAnalyzer._call_api（参谋长模型）"""
        if self._analyzer is None:
            sys.path.insert(0, str(Path(__file__).parent))
            from analyze import MacroAnalyzer
            self._analyzer = MacroAnalyzer(self.config, "", None)
        return self._analyzer

    def _ai_call(self, system, prompt, fallback):
        try:
            resp = self._ai()._call_api(system, prompt)
            resp = resp.strip().strip('"')
            return resp if resp else fallback
        except Exception as e:
            print(f"[DIALOGUE] AI call failed ({e}), fallback to template")
            return fallback

    # ---------- 主流程 ----------
    def run_interactive(self, idea, answers=None):
        """5 轮追问生成观点卡。
        answers 传预置答案列表时走非交互模式（测试/CI 用），None 时终端交互。"""
        if not idea or not str(idea).strip():
            idea = input("输入你的想法: ").strip()
        transcript = [{"round": 0, "role": "user", "text": str(idea)}]
        answers = list(answers) if answers is not None else None
        for rnd in QUESTION_ROUNDS:
            q = self._deepen_question(rnd, transcript)
            if answers is not None:
                ans = answers.pop(0) if answers else "（未回答）"
            else:
                print(f"\n【第{rnd['round']}轮 · {rnd['name']}】{q}")
                ans = input("> ").strip() or "（未回答）"
            transcript.append({"round": rnd["round"], "role": "ai_question", "text": q})
            transcript.append({"round": rnd["round"], "role": "user", "text": ans})
        card = self._build_view_card(transcript)
        self._save_card(card, transcript)
        return card

    def run_from_text(self, text, title_hint=""):
        """批量模式：草稿全文直接浓缩为观点卡（跳过追问）"""
        transcript = [
            {"round": 0, "role": "user", "text": str(text)},
            {"round": 1, "role": "ai_question", "text": "（批量模式：跳过追问，直接出卡）"},
        ]
        card = self._build_view_card(transcript)
        if title_hint:
            card["title"] = card.get("title") or title_hint[:20]
        self._save_card(card, transcript)
        return card

    def run_batch(self, idea_dir=None):
        """读目录下所有 .md 草稿逐个出观点卡"""
        d = Path(idea_dir) if idea_dir else self.idea_dir
        if not d or not d.exists():
            print(f"[DIALOGUE] idea dir not found: {d}")
            return []
        cards = []
        for md in sorted(d.glob("*.md")):
            print(f"[DIALOGUE] processing {md.name}")
            try:
                text = md.read_text(encoding="utf-8").strip()
            except Exception as e:
                print(f"  read failed: {e}")
                continue
            if text:
                cards.append(self.run_from_text(text, title_hint=md.stem))
        print(f"[DIALOGUE] batch done: {len(cards)} cards")
        return cards

    # ---------- 内部 ----------
    def _deepen_question(self, rnd, transcript):
        """结合已有对话深化固定维度的追问"""
        history = "\n".join(f"[{t['role']}] {t['text']}" for t in transcript[-6:])
        system = "你是个追根问底的参谋。基于对话历史，把固定追问深化得更具体，只输出问题本身，不超过60字。"
        prompt = f"对话历史：\n{history}\n\n本轮维度：{rnd['name']}。原始追问：{rnd['prompt']}\n输出深化后的追问。"
        return self._ai_call(system, prompt, rnd["prompt"])

    def _build_view_card(self, transcript):
        """把对话浓缩成结构化观点卡（id/时间由本端生成，AI 只填内容字段）"""
        history = "\n".join(f"[{t['role']}] {t['text']}" for t in transcript)
        system = "你是政治经济分析参谋。把用户对话浓缩为结构化观点卡，严格输出 JSON，不要 markdown。"
        resp = self._ai_call(system, history + CARD_PROMPT_TEMPLATE, "")
        card = self._parse_json(resp)
        if not card:
            first = transcript[0]["text"]
            card = {"title": first[:20], "core_claim": first, "raw_fallback": True}
        card["id"] = "view_" + uuid.uuid4().hex[:6]
        card["created"] = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        card["author"] = "user"
        card["status"] = "active"
        return card

    def _parse_json(self, text):
        text = text.strip()
        if text.startswith("```"):
            text = text.split("```")[1]
            if text.startswith("json"):
                text = text[4:]
        start = text.find("{")
        if start < 0:
            return None
        depth = 0
        for i in range(start, len(text)):
            if text[i] == "{":
                depth += 1
            elif text[i] == "}":
                depth -= 1
                if depth == 0:
                    try:
                        return json.loads(text[start:i + 1])
                    except Exception:
                        return None
        return None

    def card_to_view(self, card):
        """观点卡转假设树的 view 结构（供 hypothesis_engine 消化）"""
        return {
            "id": "card_" + card["id"],
            "view_id": "card_" + card["id"],
            "title": card.get("title", "未命名观点"),
            "core_claim": card.get("core_claim", ""),
            "evidence_basis": card.get("evidence_basis", ""),
            "key_dimensions": card.get("key_dimensions", []),
            "confidence_initial": 0.5,
            "time_horizon_months": int(card.get("time_horizon_months") or 12),
            "source": "dialogue_engine",
        }

    def feed_to_hypothesis(self, card, engine):
        """观点卡 → 假设树：复用 HypothesisEngine._decompose_view 生成假设节点并保存"""
        view = self.card_to_view(card)
        new_hyps = engine._decompose_view(view)
        hyps = engine.load_active_hypotheses()
        hyps.extend(new_hyps)
        engine.save_active_hypotheses(hyps)
        print(f"[DIALOGUE] fed {len(new_hyps)} hypothesis node(s) from card {card['id']}")
        return new_hyps

    def _save_card(self, card, transcript):
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        # 对话记录
        transcript_file = self.dialogue_dir / f"dialogue_{ts}.json"
        payload = {"card_id": card["id"], "created": card["created"], "transcript": transcript}
        transcript_file.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        # 观点卡 markdown
        lines = [
            f"# 观点卡：{card.get('title', '?')}",
            "",
            f"- **id**: {card['id']}  **created**: {card['created']}  **status**: {card['status']}",
            "",
            "## 核心观点",
            card.get("core_claim", ""),
            "",
            "## 依据",
            card.get("evidence_basis", "（未提供）"),
            "",
            "## 关键维度",
        ]
        for k in card.get("key_dimensions", []):
            lines.append(f"- {k}")
        lines += ["", "## 可验证指标"]
        for k in card.get("verifiable_indicators", []):
            lines.append(f"- {k}")
        lines += [
            "",
            "## 反驳标准",
            card.get("refute_criteria", "（未提供）"),
            "",
            "## 时间跨度",
            f"{card.get('time_horizon_months', '?')} 个月",
            "",
            "## 对个人的影响",
            card.get("personal_impact", "（未提供）"),
            "",
            f"---",
            f"对话记录：[[dialogue_{ts}]]",
        ]
        card_file = self.cards_dir / f"{card['id']}.md"
        card_file.write_text("\n".join(lines), encoding="utf-8")
        print(f"[DIALOGUE] card saved: {card_file}")
        print(f"[DIALOGUE] transcript: {transcript_file}")


def main():
    cfg_path = Path(__file__).parent.parent / "config.yaml"
    import yaml
    with open(cfg_path, "r", encoding="utf-8") as f:
        config = yaml.safe_load(f)

    parser = argparse.ArgumentParser(description="P2a 对话引擎：想法 → 5轮追问 → 观点卡")
    parser.add_argument("--interactive", nargs="?", const="", metavar="IDEA", help="交互模式，可带初始想法")
    parser.add_argument("--idea-file", metavar="PATH", help="从草稿文件出卡")
    parser.add_argument("--batch", metavar="DIR", help="批量处理目录下所有 .md 草稿")
    parser.add_argument("--feed-hyp", action="store_true", help="出卡后喂给假设树")
    args = parser.parse_args()

    engine = DialogueEngine(config)
    card = None
    if args.batch:
        engine.run_batch(args.batch)
    elif args.idea_file:
        text = Path(args.idea_file).read_text(encoding="utf-8").strip()
        card = engine.run_from_text(text)
    elif args.interactive is not None:
        card = engine.run_interactive(args.interactive)
    else:
        parser.print_help()
        return 1

    if card and args.feed_hyp:
        from load_knowledge import load_knowledge
        from hypothesis_engine import HypothesisEngine
        from analyze import MacroAnalyzer
        kb = load_knowledge(r"D:\Codex输出\视频知识库")
        kb.load_all()
        analyzer = MacroAnalyzer(config, "", kb)
        hyp_engine = HypothesisEngine(config, kb, analyzer)
        engine.feed_to_hypothesis(card, hyp_engine)
    return 0


if __name__ == "__main__":
    sys.exit(main())
